{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LoansDatabase": "Data Source=loans.db"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Outbox": {
    "BaseUrl": "http://localhost:4000",
    "PollingInterval": "00:00:02",
    "MaxAttempts": 5,
    "InitialRetryDelay": "00:00:02",
    "MaxRetryDelay": "00:05:00"
  }
}
